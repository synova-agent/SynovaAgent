{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synova.dev/schemas/plan-v1.json",
  "title": "SynovaAgent Plan Schema",
  "description": "机器可读的分阶段实施计划。由 EnterPlanMode 生成，人类审批后锁定。Agent 不能自己修改此文件。",
  "type": "object",
  "required": ["version", "created", "phases", "current_phase", "approach"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "created": { "type": "string", "format": "date-time" },
    "approved_by": { "type": "string", "description": "审批人标识（人类确认后填写）" },
    "current_phase": { "type": "integer", "minimum": 0 },
    "principles": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "enum": ["原则1: 找到根因，用一个机制防一类错", "原则2: 先设计验证标准，再设计实现", "原则3: 按依赖关系排执行顺序", "原则4: 安全边际，每一步可回滚", "原则5: 物理强制，零AI自律", "原则6: 逐步验证，不信任声称完成"] },
      "description": "Q1b 产出: 本任务应用的 Anthropic 原则"
    },
    "approach": {
      "type": "string", "enum": ["rewrite", "reuse"],
      "description": "Q2 产出: rewrite=提取算法重写纯函数, reuse=复用已有模块无需修改。桥接(import+re-export)不允许。"
    },
    "memory_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^memory/" },
      "description": "Q1a 产出: task brief 中引用的 memory/ 文件"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "action", "files"],
        "properties": {
          "step": { "type": "integer" },
          "action": { "type": "string", "enum": ["create", "wire", "refactor", "delete"] },
          "files": {
            "type": "array",
            "items": { "type": "string", "description": "精确相对路径，如 src/locale/locale-loader.ts" }
          },
          "checks": {
            "type": "object",
            "properties": {
              "wiring": { "type": "string", "enum": ["enforce", "deferred"], "default": "enforce" },
              "feature_flag": { "type": "string", "enum": ["enforce", "deferred"], "default": "enforce" },
              "test_pairing": { "type": "string", "enum": ["enforce", "deferred"], "default": "enforce" }
            }
          }
        }
      }
    }
  }
}
