{
  "cycleId": "arr-growth",
  "name": "ARR增长循环",
  "description": "SaaS行业ARR增长闭环。新客户ARR+扩展ARR-流失ARR=净新ARR，净新ARR驱动估值，估值反哺销售投入。",
  "version": "1.0.0",
  "applicableIndustries": ["saas-tech"],
  "nodes": [
    { "id": "newArr", "label": "新客户ARR", "type": "flow", "initialValue": 500, "unit": "万元/年", "edgeRefs": ["edge/value_pricing"] },
    { "id": "expansionArr", "label": "扩展ARR", "type": "flow", "initialValue": 200, "unit": "万元/年", "edgeRefs": ["edge/reputation_flywheel"] },
    { "id": "churnArr", "label": "流失ARR", "type": "flow", "initialValue": 150, "unit": "万元/年", "edgeRefs": ["edge/customer_lockin"] },
    { "id": "netArr", "label": "净新ARR", "type": "stock", "initialValue": 550, "unit": "万元/年" },
    { "id": "valuation", "label": "估值", "type": "parameter", "initialValue": 8.0, "unit": "倍ARR" },
    { "id": "salesInvestment", "label": "销售投入", "type": "flow", "initialValue": 300, "unit": "万元/年" }
  ],
  "edges": [
    { "from": "newArr", "to": "netArr", "polarity": "+", "delay": 0, "weight": 1.0 },
    { "from": "expansionArr", "to": "netArr", "polarity": "+", "delay": 0, "weight": 1.0 },
    { "from": "churnArr", "to": "netArr", "polarity": "-", "delay": 0, "weight": 1.0 },
    { "from": "netArr", "to": "valuation", "polarity": "+", "delay": 0, "weight": 0.9 },
    { "from": "valuation", "to": "salesInvestment", "polarity": "+", "delay": 1, "weight": 0.7 },
    { "from": "salesInvestment", "to": "newArr", "polarity": "+", "delay": 2, "weight": 0.5 }
  ],
  "overflowFormula": {
    "condition": "churnArr.currentValue > netArr.currentValue",
    "targetNode": "churnArr",
    "formula": "churnArr.currentValue * 0.7",
    "minDataMaturity": "high"
  },
  "dataMaturity": "high",
  "mapping": [
    { "nodeId": "newArr", "edgeId": "edge/value_pricing", "weight": 0.9 },
    { "nodeId": "expansionArr", "edgeId": "edge/reputation_flywheel", "weight": 0.7 },
    { "nodeId": "churnArr", "edgeId": "edge/customer_lockin", "weight": 1.0 },
    { "nodeId": "salesInvestment", "edgeId": "edge/capital_allocation", "weight": 0.6 }
  ],
  "crossCyclePropagation": [
    { "targetCycleId": "talent-cycle", "viaEdge": "valuation→hiring", "strength": 0.4 }
  ]
}
