{
  "$id": "edge/rule_constraint",
  "label": "RULE_CONSTRAINT",
  "tags": ["causal", "first_order", "brake", "stage_2"],
  "allowedFrom": ["pool/governance"],
  "allowedTo": ["pool/activity"],
  "requiredProps": ["constraint_strength", "scope_coverage"],
  "optionalProps": {
    "causal_strength": "number (0-1) — 因果强度（0=无因果传导，1=完全传导）",
    "rule_type": "string — 规则类型(compliance|policy|regulation)",
    "enforcement_rigor": "number (0-1) — 执法严格度",
    "exception_rate": "number (0-1) — 例外率"
  },
  "consumed_by_sentinels": [],
  "action_effect_lag": "unknown",
  "transfer_function": "rule_rigidity = compliance_burden * (1 - adaptation_speed) * (1 + brake_existence) ; brake_existence = (has_emergency_override ? 0.3 : 1.0)",
  "description": "规则约束——治理框架下制定的规则和限制，约束资本分配和人才部署的边界。"
}
