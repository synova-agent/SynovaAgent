{
  "$schema": "../../schema/role-pack-v3.schema.json",
  "schemaVersion": 3,
  "name": "role-hr",
  "version": "2.0.0",
  "type": "role-preset",
  "displayName": "hr",
  "entryPoint": "./context-manifest.yaml",
  "roleId": "hr",
  "pieces": [
    "manifest.json",
    "knowledge-scope.yaml",
    "context-manifest.yaml",
    "output-template.ref",
    "capabilities.yaml",
    "acceptance-criteria.yaml"
  ],
  "refs": [
    { "kind": "file", "path": "extensions/ontology/resource/person.json" },
    { "kind": "file", "path": "extensions/ontology/resource/team.json" },
    { "kind": "scope", "name": "people.policy" },
    { "kind": "profile", "name": "business-plan" }
  ],
  "note": "角色包的自描述契约（v2）。refs 是由 context-manifest.yaml 的 contexts[].source 按 §2.4 投影规则派生的第二份独立声明；真源是磁盘，三方（refs／source／pieces）相等才装配通过。"
}
