      "capital-health",
      "margin-health",
      "revenue-health",
      "cash-runway",
      "financing-constraint",
      "growth-quality",
      "unit-economics",
      "value-capture"
    ],
    "org": [
      "key-person-risk",
      "internal-transaction-cost",
      "network-power",
      "strategy-capability-fit",
      "resource-misallocation",
      "explore-exploit-balance",
      "routine-mutation",
      "incentive-alignment",
      "knowledge-accessibility",
      "routine-diffusion",
      "channel-capacity",
      "info-distortion",
      "org-repairability",
      "power-rigidity",
      "talent-density"
    ],
    "tech": [
      "api-coverage",
      "data-health",
      "software-health",
      "process-ai-readiness",
      "ai-ecosystem-fit",
      "agent-deployment-maturity",
      "agent-opportunity-window",
      "ai-investment-return",
      "human-agent-boundary"
    ],
    "marketing": [
      "customer-demand-shift"
    ],
    "strategy": [
      "competitive-position",
      "competitive-moat",
      "opportunity-window",
      "environment-rent-dependency",
      "niche-breadth",
      "niche-squeeze",
      "moat-dependency"
