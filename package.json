{
  "name": "synova-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synova组织智能诊断 — 独立进程，终端对话式组织诊断。配置 LLM 即用。",
  "main": "dist/index.js",
  "bin": {
    "synova": "./bin/synova"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "scripts\\agent-start.bat",
    "mvp": "tsx src/mvp-server.ts",
    "mcp": "tsx src/mcp/index.ts",
    "chat": "tsx src/cli.ts",
    "tui": "tsx src/tui-v2/chat.tsx",
    "synova": "tsx src/tui-v2/chat.tsx",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:expert-quality": "vitest run tests/expert-quality/",
    "test:expert-quality:l2": "vitest run tests/expert-quality/layer2-judge.test.ts",
    "lint": "tsc --noEmit",
    "check:iron-laws": "bash scripts/pre-commit-check.sh",
    "check:architecture": "bash scripts/check-architecture.sh",
    "check:secrets": "bash scripts/check-secrets.sh",
    "check:wire": "bash scripts/workflow/wire-check.sh",
    "check:impl": "bash scripts/workflow/checkpoint-impl.sh",
    "anthropic:decide": "bash scripts/anthropic-decide.sh",
    "workflow:start": "bash scripts/workflow/task-start.sh",
    "workflow:impl": "bash scripts/workflow/checkpoint-impl.sh",
    "workflow:design": "bash scripts/workflow/checkpoint-design.sh",
    "workflow:deploy": "bash scripts/workflow/checkpoint-deploy.sh",
    "workflow:wire": "bash scripts/workflow/wire-check.sh",
    "electron:dev": "electron electron/main.cjs",
    "electron:build": "electron-builder --config build-synova.cjs",
    "electron:build:win": "electron-builder --config build-synova.cjs --win",
    "electron:build:mac": "electron-builder --config build-synova.cjs --mac",
    "electron:verify:mac": "bash scripts/desktop/verify-package-signature.sh --all --dir release",
    "docker:build": "docker build -t synova-agent .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "check:all": "bash scripts/pre-push-check.sh",
    "hooks:install": "bash scripts/install-hooks.sh",
    "hooks:test": "echo 'feat(test): verify hook' | bash scripts/commit-msg-check.sh /dev/stdin",
    "build:backend": "bash scripts/desktop/build-backend.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@unblessed/node": "^1.0.0-alpha.23",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "chalk": "^6.0.0",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.9",
    "express": "^4.22.2",
    "express-fileupload": "^1.5.2",
    "grapheme-splitter": "^1.0.4",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "neo-blessed": "0.2.0",
    "nodemailer": "^9.1.1",
    "pino": "9.14.0",
    "pinyin-pro": "^3.29.3",
    "react": "^18.3.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/blessed": "0.1.27",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.18",
    "@vitest/coverage-v8": "4.1.8",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "patch-package": "^8.0.1",
    "react-markdown": "^10.1.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.8",
    "zustand": "^4.5.0"
  }
}
