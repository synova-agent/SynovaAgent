#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════════════
# synova-commit — 校验网守 (D201 + D311 M1b)
#
# 权威文档 #17 第二章 §2.2：通往 git commit 的唯一路径。
# 在允许提交前强制执行 pre-commit-check.sh 全部 13 组检查。
# 没有 --no-verify 标志。没有绕过开关。
#
# D311 M1b (2026-08-02): 暂存区隔离 — git commit 改显式路径（不用 -a），
# staging-guard.py 校验暂存文件归属（防 D286 卷走 D300 暂存类事故），
# 提交成功后写集标记 committed + 阶段 CP4。
#
# D307 (2026-08-15): worktree 隔离感知 — 链接 worktree 内提交后 finish 提示;
# session/<sid> 隔离分支跳过 auto-tag/auto-push（finish 合并回主后推送）。
#
# 用法:
#   synova-commit --task-id <ID> --agent <名称> --message <消息> [--files <文件...>] [--session-id <ID>]
#   synova-commit --help
#   synova-commit --health
#
# 退出码:
#   0 = 全部检查通过，提交完成
#   1 = 检查失败，提交被阻断
#   2 = 网守降级（pre-commit 缺失），允许提交但记录告警
#
# 契约:
#   @input  — task-id / agent / message / files（可选）/ session-id（可选）
#   @output — 提交确认或错误信息
#   @degraded — pre-commit 脚本未找到 → exit 2 + 告警
# ═══════════════════════════════════════════════════════════════════════════════
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
PRE_COMMIT="${SYNO_PRE_COMMIT:-$PROJECT_ROOT/scripts/pre-commit-check.sh}"
BYPASS_LOG="$PROJECT_ROOT/.claude/bypass.log"
TIMEOUT_SEC="${SYNO_COMMIT_TIMEOUT:-600}"
GATEKEEPER_STORE="$PROJECT_ROOT/.codex/settings/gatekeeper"
HEALTH_CACHE="$GATEKEEPER_STORE/.health-check"
DASHBOARD_SIGNAL="$GATEKEEPER_STORE/.dashboard-signal"
DEGRADED_LOG="$GATEKEEPER_STORE/degraded-events.log"

# ═══ 颜色（如果终端支持） ═══
if [[ -t 1 ]]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[1;33m'
  NC='\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; NC=''
fi

# ═══ 帮助 ═══

show_help() {
  cat << 'HELP'
用法: synova-commit --task-id <ID> --agent <名称> --message <消息> [--files <文件...>]

必需参数:
  --task-id <ID>         任务标识（如 "D201"）
  --agent <名称>         执行 agent（如 "claude-code"）
  --message <消息>       commit 消息

可选参数:
  --files <文件...>      要暂存的文件列表（空格分隔）
  --health               检查网守健康状态
  --help                 显示此帮助

退出码:
  0  = 全部检查通过，提交完成
  1  = 检查失败，提交被阻断
  2  = 网守降级（pre-commit 缺失），允许提交但记录告警

示例:
  synova-commit --task-id D201 --agent claude-code --message "feat: 提交示例"
  synova-commit --task-id D201 --agent claude-code --message "fix: bug" --files "src/foo.ts"
  synova-commit --health
HELP
  exit 0
}

# ═══ 健康检查 ═══

health_check() {
  local ok=true
  local reasons=()

  if [[ ! -f "$PRE_COMMIT" ]]; then
    ok=false
    reasons+=("pre-commit-check.sh 未找到: $PRE_COMMIT")
  elif [[ ! -x "$PRE_COMMIT" ]]; then
    ok=false
    reasons+=("pre-commit-check.sh 不可执行")
  fi

  if [[ ! -f "$PROJECT_ROOT/.git/hooks/pre-commit" ]]; then
    reasons+=("git pre-commit hook 未安装")
  fi

  if [[ "$ok" == "true" ]]; then
    echo "{\"ok\":true,\"reason\":\"网守健康\"}"
    exit 0
  else
    local reason_str
    reason_str=$(IFS='; '; echo "${reasons[*]}")
    echo "{\"ok\":false,\"reason\":\"$reason_str\"}"
    exit 0
  fi
}

# ═══ 仪表盘信号写入 (D201-Phase2) ═══

write_dashboard_signal() {
  local color="$1" component="$2" reason="$3"
  mkdir -p "$GATEKEEPER_STORE"
  echo "${color}|${component}|$(date -u +%Y-%m-%dT%H:%M:%SZ)|${reason}" > "$DASHBOARD_SIGNAL"
}

# ═══ 健康缓存 (D201-Phase2) ═══

check_health_cache() {
  if [[ -f "$HEALTH_CACHE" ]]; then
    local cached_time
    cached_time=$(cat "$HEALTH_CACHE" 2>/dev/null || echo 0)
    local now
    now=$(date +%s)
    local elapsed=$((now - cached_time))
    if [[ $elapsed -lt 30 ]]; then return 0; fi
  fi
  return 1
}

update_health_cache() {
  mkdir -p "$GATEKEEPER_STORE"
  date +%s > "$HEALTH_CACHE"
}

# ═══ 降级事件日志 (D201-Phase2) ═══

log_degraded() {
  local component="$1" reason="$2"
  mkdir -p "$GATEKEEPER_STORE"
  echo "{\"timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"component\":\"${component}\",\"reason\":\"${reason}\"}" >> "$DEGRADED_LOG"
}

# ═══ L8: 跨 Agent 契约一致性 (D201-Phase2) ═══

check_l8_contract_consistency() {
  local contract="$GATEKEEPER_STORE/contract.json"
  if [[ ! -f "$contract" ]]; then
    echo -e "  ${YELLOW}L8: SKIP — contract.json 缺失${NC}"
    write_dashboard_signal "YELLOW" "gatekeeper_partial" "contract_json_missing"
    log_degraded "L8" "contract.json missing"
    return 0
  fi
  local failed=0
  while IFS= read -r func_name; do
    [[ -z "$func_name" ]] && continue
    if ! grep -rn "export function $func_name\|export const $func_name" "$PROJECT_ROOT/src/" --include="*.ts" 2>/dev/null | head -1 > /dev/null; then
      echo -e "  ${RED}L8: Contract function '$func_name' not found in src/${NC}"
      failed=1
    fi
  done < <(node -e "try{const c=require('$contract');if(!c.modules)process.exit(0);for(const m of c.modules)if(m.exports)for(const e of m.exports)console.log(e.name||e)}catch(e){process.exit(1)}" 2>/dev/null || echo "")
  if [[ $failed -eq 1 ]]; then
    echo -e "  ${RED}L8: FAIL — contract consistency check failed${NC}"
    write_dashboard_signal "RED" "gatekeeper_l8" "contract_mismatch"
    return 1
  fi
  echo -e "  ${GREEN}L8: PASS — contract consistency check passed${NC}"
  return 0
}

# ═══ D319: 自动 tag + version.log + push --follow-tags ═══
# 版本权威 = .codex/control-tower/VERSION.md 最新 `## V4.x.y` 标题。
# commit 成功后: 无 tag → git tag -a（annotated 带作者/消息, 审计可溯）+
# control_tower_log.py version 追加 version.log；push 用 --follow-tags。
# 全部 fail-open: VERSION.md 缺失/无版本标题/git tag 失败 → 提示不阻断。

auto_tag_and_version() {
  # VERSION.md 跟随 cwd 仓库（git rev-parse --show-toplevel）——测试隔离需要，
  # 真实运行 cwd 即仓库根，与固定路径等价
  local REPO_ROOT=""
  REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo "$PROJECT_ROOT")
  local VERSION_MD="${SYNO_VERSION_MD:-$REPO_ROOT/.codex/control-tower/VERSION.md}"
  local LOG_PY="$PROJECT_ROOT/scripts/control-tower/control_tower_log.py"
  local ver=""
  if [[ -f "$VERSION_MD" ]]; then
    ver=$(grep -oE '^## V[0-9]+\.[0-9]+\.[0-9]+' "$VERSION_MD" | head -1 | awk '{print $2}')
  fi
  if [[ -z "$ver" ]]; then
    echo -e "  ${YELLOW}⚠ D319: VERSION.md 无版本标题 — 跳过自动 tag${NC}"
    return 0
  fi
  if git tag -l "$ver" | grep -q "$ver"; then
    echo -e "  ${GREEN}✅ D319: tag 已存在: $ver${NC}"
    return 0
  fi
  if ! git tag -a "$ver" -m "bump $ver (synova-commit auto-tag)"; then
    echo -e "  ${YELLOW}⚠ D319: 自动打 tag 失败 (git tag -a $ver) — 请手动打 tag${NC}"
    return 0
  fi
  echo -e "  ${GREEN}✅ D319: 自动打 tag: $ver${NC}"
  if [[ -f "$LOG_PY" ]]; then
    python3 "$LOG_PY" version --version "${ver#V}" --changes "auto-tag $ver" > /dev/null 2>&1 || true
  fi
}

push_with_tags() {
  local branch=""
  if ! git remote get-url origin > /dev/null 2>&1; then
    echo -e "  ${YELLOW}⚠ D319: 无 origin remote — 跳过 push（tag 已本地创建, 请手动 push --follow-tags）${NC}"
    return 0
  fi
  branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
  if [[ -z "$branch" ]]; then
    return 0
  fi
  if ! git push --follow-tags origin "$branch" 2>&1 | tail -5; then
    echo -e "  ${YELLOW}⚠ D319: push 失败 — 提交与 tag 已在本地, 请手动 git push --follow-tags origin $branch${NC}"
  fi
}

# ═══ L9: 已知错误模式自动扫描 (D201-Phase2) ═══

check_l9_error_patterns() {
  local patterns="$GATEKEEPER_STORE/known-error-patterns.json"
  if [[ ! -f "$patterns" ]]; then
    echo -e "  ${YELLOW}L9: SKIP — known-error-patterns.json 缺失${NC}"
    write_dashboard_signal "YELLOW" "gatekeeper_partial" "error_patterns_missing"
    log_degraded "L9" "known-error-patterns.json missing"
    return 0
  fi
  local staged_files
  staged_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.tsx' '*.js' '*.sh' 2>/dev/null || true)
  if [[ -z "$staged_files" ]]; then
    echo -e "  ${GREEN}L9: No staged files to scan${NC}"
    return 0
  fi
  local failed=0
  while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    local pid=$(echo "$entry" | cut -d'|' -f1)
    local pat=$(echo "$entry" | cut -d'|' -f2)
    local desc=$(echo "$entry" | cut -d'|' -f3)
    echo "$staged_files" | while IFS= read -r file; do
      [[ -z "$file" ]] && continue; [[ ! -f "$PROJECT_ROOT/$file" ]] && continue
      if grep -qE "$pat" "$PROJECT_ROOT/$file" 2>/dev/null; then
        echo -e "  ${RED}L9: $pid — $desc (in: $file)${NC}"
        failed=1
      fi
    done
  done < <(node -e "try{const p=require('$patterns');for(const i of p)if(i.auto_detectable)console.log(i.id+'|'+i.pattern+'|'+i.description)}catch(e){process.exit(0)}" 2>/dev/null || true)
  if [[ $failed -eq 1 ]]; then
    echo -e "  ${RED}L9: FAIL — known error patterns detected${NC}"
    write_dashboard_signal "RED" "gatekeeper_l9" "known_error_pattern_detected"
    return 1
  fi
  echo -e "  ${GREEN}L9: PASS — no known error patterns${NC}"
  return 0
}

# ═══ 参数解析 ═══

TASK_ID=""
AGENT=""
MESSAGE=""
FILES=()
SESSION_ID=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help)
      show_help
      ;;
    --health)
      health_check
      ;;
    --check)
      # D508: 全量 dry-run——一次跑完 plan-integrity + pre-commit 13 组 + commit-msg 格式，
      # 汇总全部失败项统一退出（不 commit 不 push）。修"逐个揭穿"7 轮循环 → 1 轮看全。
      CHECK_ONLY=1
      shift
      ;;
    --task-id)
      TASK_ID="$2"
      shift 2
      ;;
    --agent)
      AGENT="$2"
      shift 2
      ;;
    --message)
      MESSAGE="$2"
      shift 2
      ;;
    --session-id)
      SESSION_ID="$2"
      shift 2
      ;;
    --files)
      shift
      while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do
        FILES+=("$1")
        shift
      done
      ;;
    *)
      echo -e "${RED}❌ 未知参数: $1${NC}"
      echo "用法: synova-commit --task-id <ID> --agent <名称> --message <消息> [--files <文件...>]"
      exit 1
      ;;
  esac
done

# ═══ 验证必需参数 ═══

if [[ -z "$TASK_ID" ]]; then
  echo -e "${RED}❌ 缺少必需参数: --task-id${NC}"
  exit 1
fi

if [[ -z "$AGENT" ]]; then
  echo -e "${RED}❌ 缺少必需参数: --agent${NC}"
  exit 1
fi

if [[ -z "$MESSAGE" ]]; then
  echo -e "${RED}❌ 缺少必需参数: --message${NC}"
  exit 1
fi

# ═══ D515 项2 + D537 #3: 快速通道判定扩展 ═══
# 原: --files 长度==1 且为 .claude/bypass.log → SYNO_FASTLANE=1（90-120s → <3s）。
# D537 #3: 补记摩擦——merge commit + "补记+bypass 组合"跑全量 13 组 → 每次合并 5-8 分钟
#   纯门禁成本。三条快速通道（都无新代码语义，跳过非证据链组是安全降级）:
#   ① 纯 bypass.log（原 D515）
#   ② merge commit（MERGE_HEAD 存在，同 D328/D513 豁免语义——merge 无新声明）
#   ③ 纯补记组合（--files 全部为证据/簿记文件，无代码/脚本）
# ⚠️ 判定只看 --files 显式列表，不裸看暂存区（D414 会自动 add bypass.log 进正常提交）。
#   普通提交（含任何 src/scripts/packages/tests/.github/.claude/skills 代码）仍全量 13 组
#   （防 fastlane 误放行——证据/簿记白名单外的文件一律走全量）。
FASTLANE_TRIGGER=0
if [[ ${#FILES[@]} -eq 1 && "${FILES[0]}" == ".claude/bypass.log" ]]; then
  FASTLANE_TRIGGER=1   # ① 纯补记单文件
elif [[ -f "$(git rev-parse --git-dir 2>/dev/null || echo '')/MERGE_HEAD" ]]; then
  FASTLANE_TRIGGER=1   # ② merge commit
elif [[ ${#FILES[@]} -gt 0 ]]; then
  # ③ 补记组合: 全部 --files 为证据/簿记（doc 白名单同 CT-34 + .claude 日志）
  _EVIDENCE_RE='^(docs/.*\.(md|html|txt)$|\.claude/task-briefs/.*\.(md|html|txt)$|memory/.*\.(md|html|txt)$|task-state/.*\.(json|md)$|[^/]+\.(md|html|txt)$|\.claude/bypass\.log$|\.claude/[^/]*\.log$)'
  _NON_EVIDENCE=$(printf '%s\n' "${FILES[@]}" | grep -vE "$_EVIDENCE_RE" || true)
  [ -z "$_NON_EVIDENCE" ] && FASTLANE_TRIGGER=1
fi
if [[ "$FASTLANE_TRIGGER" -eq 1 ]]; then
  export SYNO_FASTLANE=1
fi

# ═══ D329: session-id 解析 (M1b 暂存区隔离 + 劫持根治) ═══
# 身份 = 会话声明的任务，绝不自动采用认领 brief（D320 劫持根因: 自动采用让
# staging-guard 把被偷文件当"自己的"）。显式 --session-id 优先。
if [[ -z "$SESSION_ID" ]]; then
  SESSION_ID="$TASK_ID"
fi
SESSION_REGISTRY="$PROJECT_ROOT/scripts/control-tower/session_registry.py"
SELF_HEALTH="$PROJECT_ROOT/scripts/control-tower/self-health.py"
STAGING_GUARD="$PROJECT_ROOT/scripts/control-tower/staging_guard.py"
WAIT_MANAGER="$PROJECT_ROOT/scripts/control-tower/wait_manager.py"

# ═══ D307: worktree 隔离感知 ═══
# 链接 worktree 判定: 链接 worktree 的 git-dir 必为 <主>/.git/worktrees/<name>
# 绝对路径; 主 worktree 的 git-dir 为 ".git"（相对）→ 子串特征可物理区分,
# 不依赖 realpath/git 版本（Mac 无 realpath, D334 双机兼容）。
# session/<sid> 分支 = worktree-manager create 的本地隔离分支:
#   - 禁止 auto-tag/auto-push（合并回主 worktree 后由主推送, 决策点 1）
#   - 提交成功后提示 finish 流程
IS_LINKED_WT=""
GITDIR_D307=$(git rev-parse --git-dir 2>/dev/null || echo "")
case "$GITDIR_D307" in
  *"/.git/worktrees/"*) IS_LINKED_WT=1 ;;
esac
CURRENT_BRANCH_D307=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
SESSION_WT_BRANCH=""
case "$CURRENT_BRANCH_D307" in
  session/*) SESSION_WT_BRANCH=1 ;;
esac

# D329: register 的 brief 路径按 TASK_ID 前缀查找实际文件（不假定 ${SESSION_ID}.md 存在）
REGISTER_BRIEF=""
for _b in "$PROJECT_ROOT"/.claude/task-briefs/${TASK_ID}.md "$PROJECT_ROOT"/.claude/task-briefs/${TASK_ID}-*.md; do
  [[ -f "$_b" ]] && REGISTER_BRIEF="$_b" && break
done

# 登记本 session（CP2 开发阶段；若已存在则刷新心跳）
# D329: write-set 登记移到 staging-guard 通过之后（防 --files 预登记"洗白"他人文件）
if [[ -f "$SESSION_REGISTRY" ]]; then
  python3 "$SESSION_REGISTRY" register --session-id "$SESSION_ID" --brief "$REGISTER_BRIEF" --task-id "$TASK_ID" 2>/dev/null || true
  python3 "$WAIT_MANAGER" phase --session-id "$SESSION_ID" --phase CP2 2>/dev/null || true
fi

# D314: 提交前 self-health 快照（fail-open，不阻断）
if [[ -f "$SELF_HEALTH" ]]; then
  python3 "$SELF_HEALTH" > /dev/null 2>&1 || true
fi

# ═══ D514/K3: F5 口径防线 —— message 含测试计数须贴 vitest summary ═══
# F5（测试计数口径不实）三度复发（D504 → D510 初版 → 纠正残留），K3 指出 bash 门禁
# 对自然语言数字无能为力，唯一防线 = 强制「计数来自命令输出」的可见检查点。
if [[ "${MESSAGE:-}" =~ [0-9]+/[0-9]+[[:space:]]*passed ]] && ! [[ "${MESSAGE:-}" =~ Tests[[:space:]]+[0-9]+[[:space:]]+passed ]]; then
  echo -e "${YELLOW}⚠ D514/F5: message 含测试计数但未粘贴 vitest summary 行（K3 建议：计数必须来自命令输出）${NC}"
fi

# ═══ D508: --check 全量 dry-run ═══
# 一次跑完全部检查器，汇总所有失败项统一输出，不 commit 不 push（修逐个揭穿循环）。
if [[ "${CHECK_ONLY:-0}" = "1" ]]; then
  # D508 沙箱加固: 断言 cwd 属于本仓库（防测试污染路径下误操作宿主）
  if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "❌ --check: 当前目录不是 git 仓库" >&2
    exit 1
  fi
  echo "🔍 D508 --check: 全量检查（不提交）"
  if [[ ${#FILES[@]} -gt 0 ]]; then
    git add -A -- "${FILES[@]}" 2>/dev/null
  fi
  FAILS=0
  echo ""
  # D515 项11: 纯补记/纯 docs 场景 plan-integrity 走快速通道（与项 2 联动）
  _DOCS_ONLY_CHECK=$(git -c core.quotepath=false diff --cached --name-only 2>/dev/null | grep -vE '^(docs/|\.claude/task-briefs/|memory/|task-state/)' | head -1 || true)
  if [[ "${SYNO_FASTLANE:-0}" == "1" ]]; then
    echo "── 检查 1/3: plan-integrity ⏭ 跳过（V5 纯补记快速通道，D515 项11）──"
  elif [[ -z "$_DOCS_ONLY_CHECK" ]]; then
    echo "── 检查 1/3: plan-integrity ⏭ 跳过（纯 docs 场景，D515 项11）──"
  else
    echo "── 检查 1/3: plan-integrity ──"
    PLAN_OUT=$(bash "$PROJECT_ROOT/scripts/check-plan-integrity.sh" 2>&1 || true)
    if echo "$PLAN_OUT" | grep -q "❌"; then
      echo "$PLAN_OUT" | grep -E "❌|^  " | head -12
      FAILS=$((FAILS+1))
    else
      echo "  ✅ plan-integrity 通过"
    fi
  fi
  echo ""
  echo "── 检查 2/3: pre-commit 13 组 ──"
  PRE_OUT=$(bash "$PROJECT_ROOT/scripts/pre-commit-check.sh" 2>&1 || true)
  # D515 项3/11: V5 后软提示不再阻断——--check 只认硬失败标记（"提交已拒绝"仅硬失败输出）
  if echo "$PRE_OUT" | grep -q "提交已拒绝"; then
    echo "$PRE_OUT" | grep -B1 -A3 "❌" | head -40
    FAILS=$((FAILS+1))
  else
    echo "  ✅ pre-commit 13 组通过（V5: 软提示不阻断，CI 为权威）"
  fi
  echo ""
  echo "── 检查 3/3: commit message 格式 ──"
  if [ -n "$MESSAGE" ]; then
    MSG_TMP=$(mktemp)
    printf '%s\n' "$MESSAGE" > "$MSG_TMP"
    MSG_OUT=$(bash "$PROJECT_ROOT/scripts/commit-msg-check.sh" "$MSG_TMP" 2>&1 || true)
    rm -f "$MSG_TMP"
    if echo "$MSG_OUT" | grep -q "❌"; then
      echo "$MSG_OUT" | grep -E "❌|正确格式" | head -8
      FAILS=$((FAILS+1))
    else
      echo "  ✅ message 格式通过"
    fi
  else
    echo "  ⏭  无 --message，跳过格式检查"
  fi
  echo ""
  if [[ $FAILS -gt 0 ]]; then
    echo "❌ --check 发现 $FAILS 类问题（上方完整清单）——一次修完后再真提交（去掉 --check）"
    exit 1
  fi
  echo "✅ --check 全部通过——可直接提交（去掉 --check 重跑）"
  exit 0
fi

# ═══ D706: 索引精确提交 + 提交树不变量校验 ═══
# 根因（实测复现，非推断）: `git commit -m msg -- <pathspec>` 走 git **部分提交机制**——对匹配
#   路径用工作区内容内部重算（内部 add），而非逐字提交索引。当路径满足
#   「索引已删除 + .gitignore 命中 + 磁盘仍存在」时（D665 摘除 gitlink 的真实形态），
#   内部 add 因该路径 ignored 而跳过 → 该删除不进提交；批次里其它路径确有变更 →
#   git 仍 exit 0 报「提交完成」→ 提交后 git 用新 HEAD 回填这些路径的索引 → 暂存态被静默销毁。
#   M2 型后果: 提交消息声称摘除 N 个文件，实际树未变
#   （实证 9aabd581 声称摘除 10 个 gitlink，`git ls-tree -r HEAD | grep -c '^160000'` 仍为 10）。
#   注: 该丢失发生在**成功路径**（提交真的完成、exit 0），不在失败回滚路径——
#   门禁失败分支只在 :763 追加 bypass.log 后 exit 1，不触碰索引（实测复现脚本证实）。
# 修法（D333 决策四步 → 收敛为组合式）:
#   ① 提交原语 = **索引精确提交**（`git commit` 无 pathspec、无 -a → 逐字提交索引，天然携带
#      删除项，且不吸收工作区未暂存变更）。前置断言 staged ⊆ FILES，保住 D329 防
#      「--files 洗白他人暂存」语义，越界 fail-closed 并点名。
#   ② 提交后校验「暂存声明集 == 实际提交变更集」；不一致 → exit 1 + 点名差异 + **还原索引**
#      （绝不静默丢失暂存态 —— 铁律 11 静默降级禁止；门禁三态 exit 2 语义留给调用方）。

# 比较基准 rev：有 HEAD 用 HEAD；空仓库（首个提交）用空树，避免 git diff 报错 → 假错配。
_d706_base_rev() {
  local _h
  _h="$(git rev-parse --verify HEAD 2>/dev/null || true)"
  if [[ -n "$_h" ]]; then printf '%s' "$_h"; else printf '%s' "$(git hash-object -t tree /dev/null 2>/dev/null || echo 4b825dc642cb6eb9a060e54bf8d69288fbee4904)"; fi
}

# 暂存声明集（相对基准的 name-status）。禁 rename 检测，保证与 git show 口径一致。
_d706_staged_state() {
  git -c core.quotepath=false diff --cached --no-renames --name-status "$(_d706_base_rev)" 2>/dev/null | LC_ALL=C sort || true
}

# staged 集合中超出 --files 路径范围的部分（按 git pathspec 语义判定，含删除项）。
# 调用前提: FILES 非空（bash 3.2 下 set -u + 空数组展开会 unbound）。
_d706_extra_staged() {
  local _ta _tc _base
  _base="$(_d706_base_rev)"
  _ta="$(mktemp)"; _tc="$(mktemp)"
  git -c core.quotepath=false diff --cached --name-only --no-renames "$_base" 2>/dev/null | grep -v '^$' > "$_ta" || true
  git -c core.quotepath=false diff --cached --name-only --no-renames "$_base" -- "${FILES[@]}" 2>/dev/null | grep -v '^$' > "$_tc" || true
  grep -vxF -f "$_tc" "$_ta" 2>/dev/null || true
  rm -f "$_ta" "$_tc" 2>/dev/null || true
}

# 索引精确提交 + 不变量校验。返回 0 = 提交成功且提交树与暂存声明逐项一致。
_d706_index_exact_commit() {
  local _msg="$1" _pre _idx _bak="" _before _after _real _rc=0 _steps
  _pre="$(git rev-parse --verify HEAD 2>/dev/null || true)"
  _idx="$(git rev-parse --git-path index 2>/dev/null || echo .git/index)"
  if [[ -f "$_idx" ]]; then _bak="$(mktemp)"; cp "$_idx" "$_bak" 2>/dev/null || true; fi
  _before="$(_d706_staged_state)"

  git commit -m "$_msg" || _rc=$?
  if [[ "$_rc" -ne 0 ]]; then
    [[ -n "$_bak" ]] && rm -f "$_bak" 2>/dev/null || true
    return "$_rc"
  fi

  # 定位真实提交：post-commit hook 会追加「登记影子提交」(仅含 bypass.log) → HEAD 可能是影子。
  # 用父子结构判定（不 sniff 提交消息，避免文案漂移误判）。
  _real="HEAD"; _steps=1
  if [[ -n "$_pre" ]]; then
    if [[ "$(git rev-parse HEAD^ 2>/dev/null || true)" != "$_pre" ]] \
       && [[ "$(git rev-parse HEAD^^ 2>/dev/null || true)" == "$_pre" ]]; then
      _real="HEAD^"; _steps=2
    fi
  fi
  _after="$(git -c core.quotepath=false show --no-renames --name-status --format="" "$_real" 2>/dev/null | grep -v '^$' | LC_ALL=C sort || true)"

  if [[ "$_before" != "$_after" ]]; then
    echo -e "${RED}❌ D706: 提交树与暂存声明不一致 — 阻断${NC}"
    echo -e "${YELLOW}  差异（< 暂存声明 / > 实际提交树）:${NC}"
    diff <(printf '%s\n' "$_before") <(printf '%s\n' "$_after") 2>/dev/null | sed 's/^/    /' || true
    echo ""
    echo -e "${YELLOW}  根因族: 部分提交原语丢弃删除项。请确认被点名路径是否满足"
    echo -e "  「索引已删除 + .gitignore 命中 + 磁盘仍存在」。${NC}"
    # fail-closed 收尾: 撤销刚落地的提交（含影子提交），并还原暂存区 ——
    # 「报告失败但提交已进历史」= 假阻断，比不拦更危险。
    if [[ -n "$_pre" ]]; then
      git reset --soft "$_pre" >/dev/null 2>&1 || true
    else
      git update-ref -d HEAD >/dev/null 2>&1 || true
    fi
    if [[ -n "$_bak" ]]; then cp "$_bak" "$_idx" 2>/dev/null || true; rm -f "$_bak" 2>/dev/null || true; fi
    echo -e "${YELLOW}  已撤销该提交（HEAD 回退 ${_steps} 步）并还原暂存区 — 工作未丢失，请修复后重试。${NC}"
    return 1
  fi
  [[ -n "$_bak" ]] && rm -f "$_bak" 2>/dev/null || true
  echo -e "${GREEN}  ✅ D706: 提交树与暂存声明一致（$(printf '%s' "$_before" | grep -c . || true) 项变更逐项核对）${NC}"
  return 0
}

# ═══ 暂存文件 ═══

if [[ ${#FILES[@]} -gt 0 ]]; then
  echo "📦 暂存 ${#FILES[@]} 个文件..."
  # D706 同族缺陷: `git add <被 .gitignore 命中的路径>` 必然拒绝（ignored）——但若该路径在索引中
  #   已处于删除态（git rm --cached 的结果），索引已经表达了意图，无需也无法再 add。
  #   旧写法 `git add "${FILES[@]}"` 整体失败 → --files 模式无法表达 D665 型摘除（可用性缺口）。
  #   逐路径判定：索引已表意 → 放行并显式提示；否则照旧硬阻断（不放宽真失败）。
  _ADD_FAIL=""; _ADD_ERR="$(mktemp)"
  for _f in "${FILES[@]}"; do
    if ! git add -- "$_f" 2>"$_ADD_ERR"; then
      if git -c core.quotepath=false diff --cached --no-renames --name-only --diff-filter=D HEAD -- "$_f" 2>/dev/null | grep -q .; then
        echo -e "  ${YELLOW}ℹ D706: ${_f} 被 .gitignore 命中且索引中已是删除态 — 跳过 git add（索引即声明）${NC}"
      else
        _ADD_FAIL="${_ADD_FAIL}${_f}: $(head -1 "$_ADD_ERR" 2>/dev/null || true)"$'\n'
      fi
    fi
  done
  rm -f "$_ADD_ERR" 2>/dev/null || true
  if [[ -n "$_ADD_FAIL" ]]; then
    echo -e "${RED}❌ 文件暂存失败${NC}"
    printf '%s' "$_ADD_FAIL" | sed 's/^/    /'
    exit 1
  fi
fi

# ═══ D311: 暂存区隔离 (M1b — 防 D286 卷走 D300 类事故) ═══
# 校验暂存文件归属: 他人活跃写集 → 硬阻断；自己/无归属 → 放行
# D331 (P2-5→P1): 裸 python3 + `|| true` 连 guard 崩溃都吞掉（D328 P1-1 同型再犯）
# → PYBIN 跨平台回退（对齐 commit-msg-check.sh/resolve-commit-brief.sh）+ rc 捕获:
#   rc==0          → 正常解析 JSON
#   rc!=0 且 block → 按 block 硬阻断（guard 用 exit 1 表达阻断）
#   rc!=0 非 JSON  → 显式 degraded 提示（执行异常不静默）
#   python 不可用  → fail-open 显式提示跳过
if [[ -f "$STAGING_GUARD" ]]; then
  STAGED_LIST=$(git -c core.quotepath=false diff --cached --name-only 2>/dev/null || true)  # D339: 中文文件名不被转义
  if [[ -n "$STAGED_LIST" ]]; then
    PYBIN=""
    for _c in python3 python py; do
      if command -v "$_c" >/dev/null 2>&1 && "$_c" -c "import sys" >/dev/null 2>&1; then PYBIN="$_c"; break; fi
    done
    if [[ -n "$PYBIN" ]]; then
      set +e
      GUARD_OUT=$("$PYBIN" "$STAGING_GUARD" --session-id "$SESSION_ID" --staged $STAGED_LIST 2>&1)
      GUARD_RC=$?
      set -e
      if [[ "$GUARD_RC" -ne 0 ]]; then
        # rc≠0: block 用 exit 1 + JSON（正常阻断）vs 崩溃（非 JSON）→ 区分显式降级
        GUARD_STATUS=$(echo "$GUARD_OUT" | "$PYBIN" -c "import json,sys; print(json.load(sys.stdin).get('status','degraded'))" 2>/dev/null || echo "degraded")
        if [[ "$GUARD_STATUS" != "block" ]]; then
          echo -e "${YELLOW}⚠ staging-guard 执行异常 (rc=$GUARD_RC) — 降级放行，请检查其日志${NC}"
          echo "$GUARD_OUT" | head -3
          echo ""
        fi
      else
        GUARD_STATUS=$(echo "$GUARD_OUT" | "$PYBIN" -c "import json,sys; print(json.load(sys.stdin).get('status','degraded'))" 2>/dev/null || echo "degraded")
      fi
    else
      GUARD_STATUS="degraded"
      echo -e "${YELLOW}⚠ staging-guard 跳过: python 不可用或损坏（fail-open 显式提示，不静默）${NC}"
    fi
    if [[ "$GUARD_STATUS" == "block" ]]; then
      # D535: 防跑偏信号接线 — block 事件自动沉淀到学习闭环（incident-loop）
      # fail-open: incident-loop 不可用 → 显式提示不阻断（铁律 24/31）
      if [[ -n "$PYBIN" ]]; then
        set +e
        INC_OUT=$("$PYBIN" "$PROJECT_ROOT/scripts/control-tower/incident-loop.py" record \
          --id "staging-block-$(date +%Y%m%d)" \
          --symptom "staging-guard block: 暂存区含他人文件" \
          --root-cause "R1" \
          --sessions "$SESSION_ID" \
          --fix "与对应 session 协调或移出文件" 2>&1)
        INC_RC=$?
        set -e
        if [[ "$INC_RC" -eq 0 ]] && echo "$INC_OUT" | grep -q '"reminder"'; then
          INC_REMINDER=$(echo "$INC_OUT" | "$PYBIN" -c "import json,sys; print(json.load(sys.stdin).get('reminder',''))" 2>/dev/null || echo "$INC_OUT")
          echo -e "${YELLOW}⚠ 事故频发提醒: ${INC_REMINDER}${NC}"
        fi
      fi
      echo ""
      echo -e "${RED}❌ 暂存区隔离 (D311 M1b) — 暂存区含他人文件:${NC}"
      echo "$GUARD_OUT" | python3 -c "
import json,sys
d=json.load(sys.stdin)
for f in d.get('foreign_files',[]):
    print(f\"  - {f['file']} (属于 session {f.get('owner_session','?')}, brief: {f.get('brief','?')})\")
" 2>/dev/null || echo "$GUARD_OUT"
      echo ""
      echo -e "${RED}  提交已阻断 — 请先与对应 session 协调或移出该文件${NC}"
      exit 1
    fi
  fi
fi

# ═══ D329: write-set 登记（guard 通过之后 — 防 --files 预登记"洗白"他人文件）═══
if [[ -f "$SESSION_REGISTRY" ]] && [[ ${#FILES[@]} -gt 0 ]]; then
  python3 "$SESSION_REGISTRY" write-set --session-id "$SESSION_ID" --add "${FILES[@]}" 2>/dev/null || true
fi

# ═══ 检查暂存区 ═══

STAGED_COUNT=$(git diff --cached --name-only | wc -l)
if [[ "$STAGED_COUNT" -eq 0 ]]; then
  echo -e "${YELLOW}⚠ 暂存区为空 — 没有要提交的变更${NC}"
  exit 0
fi

# ═══ 运行 pre-commit 检查 ═══

echo ""
echo "═══════════════════════════════════════════════════════════"
echo "  synova-commit — 校验网守"
echo "  任务: $TASK_ID | Agent: $AGENT"
echo "  暂存文件: $STAGED_COUNT"
echo "═══════════════════════════════════════════════════════════"
echo ""

# 健康缓存
update_health_cache

# D201-Phase2: L8 — 契约一致性检查
echo "── L8/9: Enhanced Checks ──"
check_l8_contract_consistency || exit 1
echo ""

# D201-Phase2: L9 — 已知错误模式扫描
check_l9_error_patterns || exit 1
echo ""

if [[ ! -f "$PRE_COMMIT" ]]; then
  echo -e "${YELLOW}⚠ pre-commit-check.sh 未找到 — 网守降级${NC}"
  echo -e "${YELLOW}⚠ 路径: $PRE_COMMIT${NC}"
  echo -e "${YELLOW}⚠ 允许提交但建议立即修复${NC}"
  echo ""

  # 记录降级
  echo "$(date -Iseconds) | DEGRADED | pre-commit-check.sh not found | TASK_ID=$TASK_ID | AGENT=$AGENT" >> "$BYPASS_LOG"

  # D706: --files 模式前置断言 — staged ⊆ FILES（防 D329「--files 洗白他人暂存」）
  if [[ ${#FILES[@]} -gt 0 ]]; then
    _EXTRA_STAGED="$(_d706_extra_staged)"
    if [[ -n "$_EXTRA_STAGED" ]]; then
      echo -e "${RED}❌ D706: 暂存区含 --files 声明之外的变更 — 已阻断${NC}"
      echo "$_EXTRA_STAGED" | sed 's/^/    /'
      echo -e "${YELLOW}  修复: 将这些路径加入 --files，或 git restore --staged <路径> 移出暂存区${NC}"
      exit 1
    fi
  fi

  # D706: 索引精确提交（不用 -a、不用 pathspec —— 逐字提交索引，天然携带删除项）
  EXIT_CODE=0
  _d706_index_exact_commit "$MESSAGE" || EXIT_CODE=$?
  if [[ $EXIT_CODE -ne 0 ]]; then
    # D706 不变量失败 / git commit 失败 → 不登记 COMMITTED（未提交不得留证据链假绿）
    echo -e "${RED}❌ git commit 失败（exit ${EXIT_CODE}）— 未提交，不登记证据链${NC}"
    echo "$(date -Iseconds) | BLOCKED | D706 commit failed (exit $EXIT_CODE) | TASK_ID=$TASK_ID | AGENT=$AGENT" >> "$BYPASS_LOG"
    exit 1
  fi
  echo -e "${GREEN}✅ 提交完成（降级模式）${NC}"
  # D508: 降级路径同样即时登记（证据链不因降级丢失）
  echo "$(date -Iseconds) | COMMITTED | pre-commit DEGRADED-PASS | TASK_ID=$TASK_ID | AGENT=$AGENT | HASH=$(git rev-parse HEAD 2>/dev/null)" >> "$BYPASS_LOG" 2>/dev/null || true

  # D319: 提交成功后自动 tag + version.log（降级路径同样执行）
  # D307: session/<sid> 隔离分支跳过 auto-tag/auto-push（本地分支, finish 合并后主推）
  if [[ $EXIT_CODE -eq 0 ]]; then
    if [[ -n "$SESSION_WT_BRANCH" ]]; then
      echo -e "  ${YELLOW}ℹ D307: ${CURRENT_BRANCH_D307} 是本地隔离分支 — 跳过 auto-tag/auto-push（finish 合并回主后推送）${NC}"
    else
      auto_tag_and_version
      push_with_tags
    fi
    if [[ -n "$IS_LINKED_WT" ]]; then
      echo -e "  ${YELLOW}ℹ D307: 本提交在 session worktree 内完成 — 回主 worktree 执行:${NC}"
      echo -e "     ${YELLOW}python scripts/control-tower/worktree-manager.py finish <sid>${NC}"
    fi
  fi

  # D311 M1b: 提交成功后释放写集（标记 committed）+ 阶段 CP4
  if [[ $EXIT_CODE -eq 0 && -f "$SESSION_REGISTRY" ]]; then
    python3 "$SESSION_REGISTRY" write-set --session-id "$SESSION_ID" --status $(git diff --cached --name-only 2>/dev/null | head -1) committed 2>/dev/null || true
    python3 "$WAIT_MANAGER" phase --session-id "$SESSION_ID" --phase CP4 2>/dev/null || true
  fi

  # D202: 提交后运行外部审计（降级模式也运行）
  AUDITOR_SCRIPT="$SCRIPT_DIR/external-auditor.sh"
  if [[ -f "$AUDITOR_SCRIPT" ]]; then
    bash "$AUDITOR_SCRIPT" --task-id "$TASK_ID" --diff "HEAD~1..HEAD" 2>/dev/null || true
  fi

  exit 2
fi

# ═══ D335: 分支同步门禁 (提交端物理强制 — 过期基线禁止提交) ═══
# 方案3(同步降频, D469): 提交前同步检查（原 D335 check-branch-sync）已砍——
# 提交时不再强制"基于最新 main"（拉平降到任务边界一次），push 时 D334 门禁 0
# 拦落后/分叉（防覆盖物理保障保留）。原 D335 双端闭环改为单端（push 端兜底）。
echo ""

# 运行 pre-commit（带超时）
# D334: Mac 无 GNU timeout（D321 同款双机差异）→ 回退直接执行并显式提示。
#   pre-commit 13 组自身 <50s，失去外层超时兜底风险可控（不静默降级: 铁律 11）。
TIMEOUT_BIN=""
for _c in timeout gtimeout; do
  if command -v "$_c" >/dev/null 2>&1; then TIMEOUT_BIN="$_c"; break; fi
done
if [[ -n "$TIMEOUT_BIN" ]]; then
  echo "🔍 运行 pre-commit 检查（${TIMEOUT_SEC}s 超时）..."
else
  echo "⚠️  timeout/gtimeout 不可用 — 无外层超时直接执行 pre-commit (D334 降级, 显式提示)"
fi
echo ""

set +e
if [[ -n "$TIMEOUT_BIN" ]]; then
  "$TIMEOUT_BIN" "$TIMEOUT_SEC" bash "$PRE_COMMIT"
else
  bash "$PRE_COMMIT"
fi
PRECOMMIT_EXIT=$?
# D334: 不在此恢复 set -e — bash 3.2 存在 set -e+elif 交互 bug:
#   set -e 恢复后, elif 的 [[ ]] 返回非零会让 else 块在子 shell 上下文执行,
#   导致 PRECOMMIT_EXIT 在 else 中报 unbound (Win/bash 5.x 无此 bug, Mac bash 3.2 复现)。
#   改法: 保持 set +e 穿过 if/elif/else 结构, 在成功路径内(commit 完成后)恢复。

echo ""

if [[ $PRECOMMIT_EXIT -eq 0 ]]; then
  # 全部通过 → 执行提交
  echo -e "${GREEN}✅ 全部 13 组检查通过${NC}"
  echo ""

  # D214: 发射 gatekeeper 信号
  python3 "$SCRIPT_DIR/emit-signal.py" gatekeeper green "all_checks_pass" 2>/dev/null || true

  # U1a/D414: bypass.log 证据链随提交入库（修 M4 "写了没提交"——:601 追加 COMMITTED 但从不 add，
  #   证据链只在工作区不进 git、换 worktree/clone 即断）。commit 前把 bypass.log 变更并入本次提交。
  if [ -f "$BYPASS_LOG" ] && ! git diff --quiet -- "$BYPASS_LOG" 2>/dev/null; then
    git add "$BYPASS_LOG" 2>/dev/null || true
    if [[ ${#FILES[@]} -gt 0 ]]; then
      FILES+=(".claude/bypass.log")  # --files 模式: 显式并入提交文件集
    fi
    echo "  ℹ D414: bypass.log 证据链随本次提交入库"
  fi

  # D706: --files 模式前置断言 — staged ⊆ FILES（防 D329「--files 洗白他人暂存」）
  if [[ ${#FILES[@]} -gt 0 ]]; then
    _EXTRA_STAGED="$(_d706_extra_staged)"
    if [[ -n "$_EXTRA_STAGED" ]]; then
      echo -e "${RED}❌ D706: 暂存区含 --files 声明之外的变更 — 已阻断${NC}"
      echo "$_EXTRA_STAGED" | sed 's/^/    /'
      echo -e "${YELLOW}  修复: 将这些路径加入 --files，或 git restore --staged <路径> 移出暂存区${NC}"
      exit 1
    fi
  fi

  # ═══ D1068: 门禁证据载体 = commit trailer ═══
  # 时机最紧: 必须在**暂存态已冻结**（D706 断言之后）且 **git commit 之前** 写标记 —
  #   标记内容含 `git write-tree`，此时树 = 即将提交的树，绑定才有意义。
  # 判据（本卡 §Q1）: trailer 值 = sha256(标记内容)，标记只在门禁跑完后写出 ⇒
  #   未跑门禁则算不出 trailer（C3「改坏即红」的物理基础）。
  # 降级（铁律 11，不静默）: 标记写入失败 ⇒ **不阻断提交**（提交本身合法），但显式告警 +
  #   记 degraded-events.log；该提交将对账失败，由 D331 语义拦在**推送闸**（比本地硬拦更正确：
  #   证据缺失是「不能推送」而非「不能提交」——提交不产生共享状态）。
  EVIDENCE_SH="$SCRIPT_DIR/precommit-evidence.sh"
  if [[ -f "$EVIDENCE_SH" ]]; then
    if bash "$EVIDENCE_SH" write 2>/dev/null; then
      _PC_SHA="$(bash "$EVIDENCE_SH" hash 2>/dev/null || true)"
      if [[ -n "$_PC_SHA" ]]; then
        MESSAGE="$(printf '%s\n\nPreCommit-PASS: %s' "$MESSAGE" "$_PC_SHA")"
        echo -e "  ${GREEN}🔏 D1068: 门禁证据 trailer 已置入（PreCommit-PASS: ${_PC_SHA:0:12}…）${NC}"
      else
        echo -e "  ${YELLOW}⚠ D1068: 标记已写但 sha256 计算失败 — trailer 未置入，本提交将对账失败（不阻断提交）${NC}"
        echo "$(date -Iseconds) | DEGRADED | D1068 trailer 未置入: sha256 计算失败 | TASK_ID=$TASK_ID" >> "$DEGRADED_LOG" 2>/dev/null || true
      fi
    else
      echo -e "  ${YELLOW}⚠ D1068: 门禁标记写入失败 — trailer 未置入，本提交将对账失败（不阻断提交）${NC}"
      echo "$(date -Iseconds) | DEGRADED | D1068 trailer 未置入: 标记写入失败 | TASK_ID=$TASK_ID" >> "$DEGRADED_LOG" 2>/dev/null || true
    fi
  else
    echo -e "  ${YELLOW}⚠ D1068: precommit-evidence.sh 缺失 — trailer 未置入（对账缺证据）${NC}"
  fi

  # D706: 索引精确提交（不用 -a、不用 pathspec —— 逐字提交索引，天然携带删除项）
  COMMIT_EXIT=0
  _d706_index_exact_commit "$MESSAGE" || COMMIT_EXIT=$?

  if [[ $COMMIT_EXIT -eq 0 ]]; then
    echo -e "${GREEN}✅ 提交完成${NC}"
    # D521/不变量2: COMMITTED 登记已由 post-commit hook 层统一完成（覆盖裸 git 与本路径，
    #   原 D508 追加已去重删除——再写会与 hook 重复且留脏）。
    #   注意: hook 的登记提交使 HEAD 前移一位——真实提交 = HEAD^（影子为登记提交时）。
    set -e # D334: 成功路径恢复 set -e — 保护 auto_tag/push 等后续函数 (bash 3.2 elif bug 规避)
    # D319: 提交成功后自动 tag + version.log + push --follow-tags
    # D307: session/<sid> 隔离分支跳过 auto-tag/auto-push（本地分支, finish 合并后主推）
    # D521: SYNO_SUBMIT_MODE=1（synova-submit 编排）——只做 commit；tag/push 由 submit 第⑥步
    #   按 §6 纪律处理（tag 在 main 合并后打，绝不在分支自动打）
    if [[ "${SYNO_SUBMIT_MODE:-0}" == "1" ]]; then
      echo -e "  ${YELLOW}ℹ D521: submit 模式——跳过 auto-tag/auto-push（tag 在 main 合并后打，§6）${NC}"
    elif [[ -n "$SESSION_WT_BRANCH" ]]; then
      echo -e "  ${YELLOW}ℹ D307: ${CURRENT_BRANCH_D307} 是本地隔离分支 — 跳过 auto-tag/auto-push（finish 合并回主后推送）${NC}"
    else
      auto_tag_and_version
      push_with_tags
    fi
    if [[ -n "$IS_LINKED_WT" ]]; then
      echo -e "  ${YELLOW}ℹ D307: 本提交在 session worktree 内完成 — 回主 worktree 执行:${NC}"
      echo -e "     ${YELLOW}python scripts/control-tower/worktree-manager.py finish <sid>${NC}"
    fi
    # D311 M1b: 提交成功后释放写集（标记 committed）+ 阶段 CP4
    if [[ -f "$SESSION_REGISTRY" ]]; then
      # D521: HEAD 可能是 hook 的登记影子提交（只含 bypass.log）——回退到真实提交取文件清单
      _CF_REF="HEAD"
      if git log -1 --format=%s 2>/dev/null | grep -q "bypass COMMITTED 登记"; then _CF_REF="HEAD^"; fi
      COMMITTED_FILES=$(git show --name-only --format="" "$_CF_REF" 2>/dev/null | grep -v '^$' | head -50 || true)
      for cf in $COMMITTED_FILES; do
        python3 "$SESSION_REGISTRY" write-set --session-id "$SESSION_ID" --status "$cf" committed 2>/dev/null || true
      done
      python3 "$WAIT_MANAGER" phase --session-id "$SESSION_ID" --phase CP4 2>/dev/null || true
    fi

    # D202: 提交后运行外部审计（非阻塞 — 不因审计失败而阻断）
    AUDITOR_SCRIPT="$SCRIPT_DIR/external-auditor.sh"
    if [[ -f "$AUDITOR_SCRIPT" ]]; then
      bash "$AUDITOR_SCRIPT" --task-id "$TASK_ID" --diff "HEAD~1..HEAD" 2>/dev/null || true
    else
      echo "$(date -Iseconds) | AUDITOR_MISSING | external-auditor.sh not found | TASK_ID=$TASK_ID" >> "$BYPASS_LOG"
    fi

    exit 0
  else
    echo -e "${RED}❌ git commit 失败（exit ${COMMIT_EXIT}）${NC}"
    exit 1
  fi

elif [[ $PRECOMMIT_EXIT -eq 124 ]]; then
  # 超时
  echo -e "${RED}❌ pre-commit 检查超时（${TIMEOUT_SEC}s）${NC}"
  echo -e "${YELLOW}  pre-commit-check.sh 组 6（plan-integrity）可能有性能问题${NC}"
  echo -e "${YELLOW}  建议: 优化 check-plan-integrity.sh 或增加 TIMEOUT_SEC${NC}"
  echo "$(date -Iseconds) | TIMEOUT | pre-commit timed out after ${TIMEOUT_SEC}s | TASK_ID=$TASK_ID | AGENT=$AGENT" >> "$BYPASS_LOG"
  exit 1

else
  # 检查失败
  echo -e "${RED}❌ pre-commit 检查未通过（exit ${PRECOMMIT_EXIT}）${NC}"
  echo ""
  echo "═══════════════════════════════════════════════════════════"
  echo "  提交被阻断 — 请修复上述问题后重试"
  echo "  synova-commit 没有 --no-verify 选项"
  echo "═══════════════════════════════════════════════════════════"
  echo "$(date -Iseconds) | BLOCKED | pre-commit FAIL (exit $PRECOMMIT_EXIT) | TASK_ID=$TASK_ID | AGENT=$AGENT" >> "$BYPASS_LOG"
  exit 1
fi
